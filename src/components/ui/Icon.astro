---
import { strokeIcons, brandIcons } from '../../lib/icons';

interface Props {
  name: string;
  size?: number;
  class?: string;
  /** Texto accesible. Si se omite, el icono es decorativo (aria-hidden). */
  label?: string;
}
const { name, size = 20, class: className, label } = Astro.props;
const brand = brandIcons[name];
const stroke = strokeIcons[name] ?? (brand ? undefined : strokeIcons['sparkle']);
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---
{
  brand ? (
    <svg class={className} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" focusable="false" {...a11y}>
      <path d={brand} />
    </svg>
  ) : (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      focusable="false"
      {...a11y}
      set:html={stroke}
    />
  )
}
