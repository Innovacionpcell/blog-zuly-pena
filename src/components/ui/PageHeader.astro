---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, subtitle, crumbs = [] } = Astro.props;
---
<section class="phead">
  <div class="container">
    {
      crumbs.length > 0 && (
        <nav aria-label="Ruta de navegación" class="phead__crumbs">
          <ol>
            <li><a href="/">Inicio</a></li>
            {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
          </ol>
        </nav>
      )
    }
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="phead__title">{title}</h1>
    {subtitle && <p class="phead__sub">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .phead {
    padding-block: clamp(40px, 7vw, 80px) clamp(24px, 4vw, 40px);
    background:
      radial-gradient(50% 80% at 90% 0%, #efedff 0%, transparent 70%),
      radial-gradient(40% 80% at 0% 0%, #eaf6ff 0%, transparent 70%);
  }
  .phead__crumbs ol {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--c-text-3);
    margin-bottom: 22px;
  }
  .phead__crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    color: #b7bdd6;
  }
  .phead__crumbs a {
    text-decoration: none;
  }
  .phead__crumbs a:hover {
    color: var(--c-violet-deep);
  }
  .phead__title {
    margin-top: 12px;
    font-size: clamp(2rem, 5vw, 3.2rem);
    color: var(--c-navy);
    letter-spacing: -0.03em;
    max-width: 22ch;
  }
  .phead__sub {
    margin-top: 16px;
    font-size: clamp(1.03rem, 1.7vw, 1.2rem);
    color: var(--c-text-2);
    max-width: 60ch;
  }
</style>
