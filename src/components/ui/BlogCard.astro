---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { formatDate, type Post } from '../../data/blog';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { post, headingLevel: H = 'h3', eager = false } = Astro.props;
const { title, excerpt, category, date, cover, coverAlt } = post.data;
const href = `/blog/${post.id}/`;
---
<article class="bcard">
  <div class="bcard__media">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[360, 560, 760]}
      sizes="(min-width: 1100px) 360px, (min-width: 700px) 45vw, 92vw"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="bcard__img"
    />
  </div>
  <div class="bcard__body">
    <div class="bcard__meta">
      <span class="bcard__cat">{category}</span>
      <span aria-hidden="true">·</span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </div>
    <H class="bcard__title"><a href={href}>{title}</a></H>
    <p class="bcard__excerpt">{excerpt}</p>
    <span class="bcard__cta" aria-hidden="true">Leer artículo <Icon name="arrow-right" size={18} /></span>
  </div>
</article>

<style>
  .bcard {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .bcard:hover,
  .bcard:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .bcard__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--grad-soft);
  }
  .bcard__media :global(.bcard__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }
  .bcard:hover :global(.bcard__img) {
    transform: scale(1.04);
  }
  .bcard__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px 24px;
    flex: 1;
  }
  .bcard__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--c-text-3);
  }
  .bcard__cat {
    font-weight: 700;
    color: var(--c-violet-deep);
  }
  .bcard__title {
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .bcard__title a {
    text-decoration: none;
  }
  .bcard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .bcard__excerpt {
    color: var(--c-text-2);
    font-size: 0.95rem;
  }
  .bcard__cta {
    margin-top: auto;
    padding-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--c-violet-deep);
  }
  .bcard__cta :global(svg) {
    transition: transform 0.25s var(--ease);
  }
  .bcard:hover .bcard__cta :global(svg) {
    transform: translateX(3px);
  }
</style>
