---
/**
 * Fachada ligera de YouTube: no carga el iframe (≈1 MB) hasta que la persona pulsa "reproducir".
 * Usa youtube-nocookie.com para mayor privacidad.
 */
import Icon from './Icon.astro';
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---
<div class="lyt" data-lyt={id} data-title={title}>
  <img src={thumb} alt="" loading="lazy" decoding="async" width="480" height="360" class="lyt__thumb" onerror="this.style.visibility='hidden'" />
  <button type="button" class="lyt__play" aria-label={`Reproducir video: ${title}`}>
    <Icon name="play" size={26} />
  </button>
  <span class="lyt__caption">{title}</span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lyt]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const id = el.dataset.lyt;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title ?? 'Video de YouTube';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
      el.classList.add('is-playing');
    });
  });
</script>

<style>
  .lyt {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #0d1330;
    box-shadow: var(--shadow-md);
  }
  .lyt__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.3s;
  }
  .lyt:hover .lyt__thumb {
    opacity: 1;
  }
  .lyt__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    border: 0;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.95);
    color: var(--c-violet-deep);
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    transition: transform 0.25s var(--ease);
  }
  .lyt__play :global(svg) {
    margin-left: 4px;
    fill: currentColor;
  }
  .lyt__play:hover {
    transform: scale(1.06);
  }
  .lyt__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 28px 16px 12px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(transparent, rgba(10, 14, 40, 0.8));
    pointer-events: none;
  }
  .lyt :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
