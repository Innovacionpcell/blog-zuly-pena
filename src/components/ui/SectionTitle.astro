---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
  id?: string;
}
const { eyebrow, title, subtitle, align = 'center', as: Tag = 'h2', id } = Astro.props;
---
<header class:list={['section-title', `section-title--${align}`, 'reveal']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id} class="section-title__h"><Fragment set:html={title} /></Tag>
  {subtitle && <p class="section-title__sub">{subtitle}</p>}
</header>

<style>
  .section-title {
    display: grid;
    gap: 14px;
    margin-bottom: clamp(32px, 5vw, 56px);
    max-width: 720px;
  }
  .section-title--center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }
  .section-title__h {
    font-size: clamp(1.85rem, 4.2vw, 2.75rem);
    color: var(--c-text);
  }
  .section-title__sub {
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    color: var(--c-text-2);
    max-width: 60ch;
  }
</style>
