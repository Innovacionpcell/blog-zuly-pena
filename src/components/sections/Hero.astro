---
import { Image } from 'astro:assets';
import retrato from '../../assets/images/zuly-pena-retrato.jpg';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow">Mentora de mujeres · Autora</p>
      <h1 id="hero-title" class="hero__title">
        Transforma tu trabajo, reconoce tu valor y construye una vida con <span class="text-gradient">propósito</span>.
      </h1>
      <p class="hero__lead">
        Un espacio creado por Zuly Peña para mujeres que quieren crecer, profesionalizarse y dejar de vivir únicamente en
        modo supervivencia.
      </p>
      <div class="hero__ctas">
        <Button href="#recursos" size="lg" icon="arrow-right">Explorar recursos</Button>
        <Button href="/libro/" size="lg" variant="secondary" iconLeft="book-open">Conoce mi libro</Button>
      </div>
      <ul class="hero__pillars" aria-label="Pilares">
        <li><Icon name="sparkles" size={16} />Valor personal</li>
        <li><Icon name="sprout" size={16} />Crecimiento</li>
        <li><Icon name="hand-coins" size={16} />Prosperidad</li>
      </ul>
    </div>

    <div class="hero__visual">
      <div class="hero__frame">
        <Image
          src={retrato}
          alt="Retrato de Zuly Peña sonriendo, con blazer blanco"
          widths={[320, 480, 640, 800]}
          sizes="(min-width: 1024px) 460px, (min-width: 640px) 420px, 82vw"
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
      </div>
      <figure class="hero__quote">
        <Icon name="quote" size={18} />
        <blockquote>Tu trabajo no te define, <strong>tus decisiones sí.</strong></blockquote>
      </figure>
      <a class="hero__badge" href="/libro/">
        <span class="hero__badge-icon"><Icon name="book-open" size={18} /></span>
        <span><small>Autora de</small>Limpieza rima con riqueza</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(36px, 7vw, 96px) clamp(56px, 8vw, 110px);
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(55% 60% at 88% 20%, #eef0ff 0%, transparent 70%),
      radial-gradient(45% 55% at 5% 0%, #eaf6ff 0%, transparent 70%),
      #fff;
  }
  .hero__grid {
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
  .hero__copy {
  }
  .hero__title {
    margin-top: 18px;
    font-size: clamp(2.05rem, 5.4vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--c-navy);
    font-weight: 750;
  }
  .hero__lead {
    margin-top: 20px;
    font-size: clamp(1.03rem, 1.7vw, 1.2rem);
    color: var(--c-text-2);
    max-width: 54ch;
  }
  .hero__ctas {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 479.98px) {
    .hero__ctas :global(.btn) {
      width: 100%;
    }
  }
  .hero__pillars {
    list-style: none;
    padding: 0;
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--c-text-3);
  }
  .hero__pillars li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .hero__pillars :global(svg) {
    color: var(--c-violet);
  }

  /* Visual */
  .hero__visual {
    position: relative;
    width: min(100%, 460px);
    margin-inline: auto;
  }
  .hero__visual::before {
    content: '';
    position: absolute;
    inset: 8% -6% -4% 10%;
    border-radius: 50% 50% var(--r-xl) var(--r-xl);
    background: var(--grad-brand);
    opacity: 0.16;
    transform: rotate(4deg);
    z-index: -1;
  }
  .hero__frame {
    /* Arco: el semicírculo superior coincide con el recorte circular del retrato */
    border-radius: 50% 50% var(--r-xl) var(--r-xl);
    overflow: hidden;
    background: #f2f2f2;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 1;
  }
  .hero__frame :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__quote {
    position: absolute;
    left: -6%;
    bottom: 12%;
    max-width: 250px;
    display: flex;
    gap: 10px;
    padding: 14px 16px;
    border-radius: var(--r-md);
    background: rgba(22, 33, 74, 0.92);
    color: #fff;
    font-size: 0.875rem;
    line-height: 1.45;
    box-shadow: var(--shadow-md);
  }
  .hero__quote :global(svg) {
    flex: none;
    color: #9fdcff;
    margin-top: 2px;
  }
  .hero__badge {
    position: absolute;
    right: -4%;
    top: 8%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    border-radius: 999px;
    background: #fff;
    box-shadow: var(--shadow-md);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--c-navy);
    line-height: 1.2;
    transition: transform 0.3s var(--ease);
  }
  .hero__badge:hover {
    transform: translateY(-2px);
  }
  .hero__badge small {
    display: block;
    font-weight: 500;
    color: var(--c-text-3);
    font-size: 0.72rem;
  }
  .hero__badge-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--grad-brand);
    color: #fff;
  }
  @media (max-width: 639.98px) {
    .hero__quote {
      left: 0;
      bottom: -18px;
      max-width: 78%;
    }
    .hero__badge {
      right: 0;
      top: -14px;
    }
  }

</style>
